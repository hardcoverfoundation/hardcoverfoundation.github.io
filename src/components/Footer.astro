---
const year = new Date().getFullYear();
const navItems = [
  { href: '/programs', label: 'Programs' },
  { href: '/stories', label: 'Stories' },
  { href: '/news', label: 'News' },
  { href: '/team', label: 'Team' },
] as const;
---

<footer class="border-rule-on-ink bg-ink text-paper border-t">
  <div class="mx-auto max-w-5xl px-6 py-10 text-sm">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-paper text-lg">Hardcover Foundation</p>
        <p class="text-paper/70 mt-2">Building living libraries where kids choose their own books.</p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex gap-6">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-paper/80 decoration-paper/30 hover:decoration-paper">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="text-paper/50 mt-8">&copy; {year} Hardcover Foundation. All rights reserved.</p>
  </div>
</footer>
