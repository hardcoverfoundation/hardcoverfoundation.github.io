---
// Smaller interior-page banner, distinct from Hero.astro (which is sized
// and slotted for the homepage concept specifically — docs/design-plan.md
// §7 "Concept A"). Renders the page's <h1>; pages that use this component
// should not render their own top-level heading elsewhere.
interface Props {
  eyebrow?: string;
  title: string;
  dek?: string;
}

const { eyebrow, title, dek } = Astro.props;
---

<section class="bg-ink px-5 py-16 text-paper md:py-20">
  <div class="mx-auto max-w-4xl">
    {
      eyebrow && (
        <p class="font-display text-sm uppercase tracking-[0.25em] text-gold">
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-3 font-display text-4xl font-semibold leading-[1.05] md:text-5xl">
      {title}
    </h1>
    {dek && <p class="mt-6 max-w-2xl text-lg text-paper/70">{dek}</p>}
  </div>
</section>
